# ==============================================================================
# SharePad Backend - Environment Variable Reference / Local Testing Template
# ==============================================================================

# Activate production profile (for local testing with prod settings)
SPRING_PROFILES_ACTIVE=prod

# Server port (default 8080)
PORT=8080

# PostgreSQL Database Configuration
# Format: jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
DB_URL=jdbc:postgresql://your-db-host.neon.tech/sharepad?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Cloudflare R2 / S3-compatible Object Storage
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sharepad-storage
